# Local-dev values matching infra/docker compose. Copy to .env. Never commit real secrets.

# --- database ---
# (required) Runtime Postgres URL (role wb_app, RLS enforced).
DATABASE_URL=postgres://wb_app:wb_app@localhost:5432/wise_biz
# Migration URL (role wb_migrator, owns schemas).
DATABASE_MIGRATOR_URL=postgres://wb_migrator:wb_migrator@localhost:5432/wise_biz
# (required) Audit chainer URL (role wb_chainer: UPDATE hash columns only).
DATABASE_CHAINER_URL=postgres://wb_chainer:wb_chainer@localhost:5432/wise_biz
# (required) Identity URL (role wb_identity: the only role with access to the global identity schema).
DATABASE_IDENTITY_URL=postgres://wb_identity:wb_identity@localhost:5432/wise_biz
# Audit chain loop interval in ms, 100-300000 (default 2000).
AUDIT_CHAIN_INTERVAL_MS=2000
# Pool size, integer 1-200 (default 10).
DATABASE_POOL_MAX=10

# --- redis ---
# (required) Redis URL, redis:// or rediss://.
REDIS_URL=redis://localhost:6379

# --- kafka ---
# (required) Comma-separated Kafka/Redpanda brokers.
KAFKA_BROKERS=localhost:19092

# --- auth ---
# (required) Session signing secret, min 32 chars. Placeholder is dev only; generate a real one elsewhere.
AUTH_SECRET=dev-only-change-me-dev-only-change-me
# (required) Public base URL of the app.
AUTH_URL=http://localhost:3000

# --- storage ---
# S3-compatible endpoint; leave empty for AWS S3.
STORAGE_ENDPOINT=http://localhost:9000
# Region (default us-east-1).
STORAGE_REGION=us-east-1
# (required) Bucket name.
STORAGE_BUCKET=wise-biz
# (required) Access key id. Value is the local RustFS dev credential only.
STORAGE_ACCESS_KEY_ID=wb-dev-access
# (required) Secret access key. Value is the local RustFS dev credential only.
STORAGE_SECRET_ACCESS_KEY=wb-dev-secret-change-me
# Path-style addressing; true for local RustFS (default false).
STORAGE_FORCE_PATH_STYLE=true

# --- email ---
# Provider: capture | smtp | resend | brevo (default capture; forbidden in production).
EMAIL_PROVIDER=smtp
# (required) Sender address.
EMAIL_FROM=no-reply@wise-biz.local
# SMTP URL when EMAIL_PROVIDER=smtp (Mailpit locally).
SMTP_URL=smtp://localhost:1025
# Resend API key when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Brevo API key when EMAIL_PROVIDER=brevo.
BREVO_API_KEY=

# --- observability ---
# (required) development | test | production. No default: dev auth and /openapi.json key off it.
NODE_ENV=development
# fatal | error | warn | info | debug | trace (default info).
LOG_LEVEL=info
# OTLP exporter endpoint; empty disables.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sentry DSN; empty disables.
SENTRY_DSN=

# --- http ---
# Listen port, 1-65535 (default 3001).
PORT=3001
# Comma-separated CORS origin allowlist; empty allows none.
CORS_ORIGINS=http://localhost:3000
# Trusted reverse-proxy hops in front of the API, integer 0-10 (default 0 = use the socket peer address only).
# N>0: the client IP is the Nth entry from the right of X-Forwarded-For (rate limits, session ip_address).
TRUST_PROXY_HOPS=0

# --- worker ---
# (required) Worker Postgres URL (role wb_worker: relay + consumers, cross-tenant via explicit policies).
DATABASE_WORKER_URL=postgres://wb_worker:wb_worker@localhost:5432/wise_biz
# Outbox rows claimed per relay tick, integer 1-5000 (default 500).
WORKER_RELAY_BATCH=500
# Relay sleep when the outbox is empty, ms 10-60000 (default 250).
WORKER_IDLE_MS=250
# Outbox claim lease, ms 1000-3600000 (default 300000). A crashed worker's rows are redelivered after it.
WORKER_LEASE_MS=300000
# Relay publish attempts before a row is quarantined, integer 1-1000 (default 10).
WORKER_MAX_ATTEMPTS=10
# Per-handler timeout in a consumer transaction, ms 100-600000 (default 30000).
WORKER_HANDLER_TIMEOUT_MS=30000
