# Local-dev values matching infra/docker compose. Copy to .env. Never commit real secrets.

# --- database ---
# (optional) Host port for the compose Postgres. Change it (and the port in every DATABASE_*_URL below) when
# another Postgres already holds 5432, for example one inside WSL. Docker then cannot publish the port.
# POSTGRES_HOST_PORT=5432
# (required) Runtime Postgres URL (role wb_app, RLS enforced).
DATABASE_URL=postgres://wb_app:wb_app@localhost:5432/wise_biz
# Migration URL (role wb_migrator, owns schemas).
DATABASE_MIGRATOR_URL=postgres://wb_migrator:wb_migrator@localhost:5432/wise_biz
# (required) Audit chainer URL (role wb_chainer: UPDATE hash columns only).
DATABASE_CHAINER_URL=postgres://wb_chainer:wb_chainer@localhost:5432/wise_biz
# (required) Identity URL (role wb_identity: the only role with access to the global identity schema).
DATABASE_IDENTITY_URL=postgres://wb_identity:wb_identity@localhost:5432/wise_biz
# Audit chain loop interval in ms, 100-300000 (default 2000).
AUDIT_CHAIN_INTERVAL_MS=2000
# Pool size, integer 1-200 (default 10).
DATABASE_POOL_MAX=10
# Optional read replica (Neon read-only endpoint, role wb_app): reports read from it, the rest from DATABASE_URL. Locally it is the same database; delete the line to turn it off.
DATABASE_READ_URL=postgres://wb_app:wb_app@localhost:5432/wise_biz

# --- redis ---
# (required) Redis URL, redis:// or rediss://.
REDIS_URL=redis://localhost:6379

# --- kafka ---
# (required) Comma-separated Kafka/Redpanda brokers.
KAFKA_BROKERS=localhost:19092

# --- auth ---
# (required) Session signing secret, min 32 chars. Placeholder is dev only; generate a real one elsewhere.
AUTH_SECRET=dev-only-change-me-dev-only-change-me
# (required) Public base URL of the app.
AUTH_URL=http://localhost:3000
# (required) Invite token HMAC key, min 32 chars. Placeholder is dev only; never reuse it in production.
INVITE_SECRET=dev-only-change-me-invite-secret-0123456789
# (required) Operator PIN pepper, min 32 chars. Rotating it invalidates every PIN. Placeholder is dev only.
PIN_PEPPER=dev-only-change-me-pin-pepper-0123456789ab
# WebAuthn relying-party id: bare hostname, no scheme or port (default localhost).
AUTH_RP_ID=localhost
# (required) Public base URL of the console; verification and invite links point here.
CONSOLE_URL=http://localhost:3000
# Dev seed password for the demo users (min 12 chars). Leave empty outside `pnpm db:seed`; refused in production.
DEMO_PASSWORD=

# --- storage ---
# S3-compatible endpoint; leave empty for AWS S3.
STORAGE_ENDPOINT=http://localhost:9000
# Region (default us-east-1).
STORAGE_REGION=us-east-1
# (required) Bucket name.
STORAGE_BUCKET=wise-biz
# (required) Access key id. Value is the local RustFS dev credential only.
STORAGE_ACCESS_KEY_ID=wb-dev-access
# (required) Secret access key. Value is the local RustFS dev credential only.
STORAGE_SECRET_ACCESS_KEY=wb-dev-secret-change-me
# Path-style addressing; true for local RustFS (default false).
STORAGE_FORCE_PATH_STYLE=true
# R2 free-tier caps (ADR 0023): used only when STORAGE_ENDPOINT is a Cloudflare R2 endpoint. Defaults shown.
R2_LIMIT_STORAGE_BYTES=9500000000
R2_LIMIT_CLASS_A=900000
R2_LIMIT_CLASS_B=9500000
# Day of the month your Cloudflare billing period starts (1 to 28).
R2_PERIOD_ANCHOR_DAY=1
# API token with Account Analytics: Read; lets the cap see usage from every source.
CLOUDFLARE_ANALYTICS_TOKEN=
# Cloudflare account id; the r2-usage script reads it (default: taken from STORAGE_ENDPOINT).
CLOUDFLARE_ACCOUNT_ID=

# --- email ---
# Which provider sends: auto | smtp | brevo-api | resend | brevo-smtp | capture (default auto; capture is refused in production).
# auto tries every configured provider in this order: smtp (local relay), brevo-api, resend, brevo-smtp,
# and moves to the next when one fails for an account reason (bad key, no credits, daily limit).
EMAIL_PROVIDER=auto
# auto only: providers to try first, comma separated (for example resend,brevo-api).
EMAIL_PROVIDER_ORDER=
# (required) Sender address for transactional mail. Providers below can override it.
MAIL_FROM=no-reply@wise-biz.local
# Copies of every mail, comma separated (up to 10 each). Empty = none.
MAIL_CC_EMAILS=
MAIL_BCC_EMAILS=
# redacted (default): copies arrive in a separate mail with links and 6-8 digit codes removed, so a copy cannot be used
# to accept an invite or verify an account. full: real CC and BCC on the mail itself (full links and codes).
MAIL_COPY_MODE=redacted

# Local SMTP relay (Mailpit in development, no auth, no TLS). Leave empty in production.
MAIL_SMTP_HOST=localhost
# SMTP port, integer 1-65535 (default 587). Mailpit listens on 1025.
MAIL_SMTP_PORT=1025

# Resend (free: 100 mails a day, 3000 a month). Sender must be on a domain verified at Resend; default MAIL_FROM.
RESEND_API_KEY=
RESEND_EMAIL_SENDER_EMAIL=
RESEND_DAILY_LIMIT=100

# Brevo API (free: 300 mails a day). Sender must be a verified Brevo sender; default MAIL_FROM.
BREVO_API_KEY=
BREVO_EMAIL_SENDER_USER=
BREVO_DAILY_LIMIT=300
# Brevo SMTP relay (needs the host, the login and the SMTP key, all three; used by brevo-smtp).
BREVO_EMAIL_HOST=
BREVO_EMAIL_PORT=587
BREVO_EMAIL_USE_TLS=true
BREVO_EMAIL_HOST_USER=
BREVO_EMAIL_HOST_PASSWORD=

# --- observability ---
# (required) development | test | production. No default: /openapi.json and production guards key off it.
NODE_ENV=development
# fatal | error | warn | info | debug | trace (default info).
LOG_LEVEL=info
# OTLP exporter endpoint; empty disables.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sentry DSN; empty disables.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# --- http ---
# Listen port, 1-65535 (default 3001).
PORT=3001
# Comma-separated CORS origin allowlist; empty allows none.
CORS_ORIGINS=http://localhost:3000
# Trusted reverse-proxy hops in front of the API, integer 0-10 (default 0 = use the socket peer address only).
# N>0: the client IP is the Nth entry from the right of X-Forwarded-For (rate limits, session ip_address).
TRUST_PROXY_HOPS=0

# --- realtime ---
# HMAC key shared by the API (mints stream tickets) and apps/realtime (verifies them), at least 32 chars; empty disables.
REALTIME_TICKET_SECRET=
# Public base URL terminals use to open the SSE stream; empty disables the ticket route.
REALTIME_URL=
# Realtime listen port, 0-65535 (default 3002; 0 = ephemeral, for tests).
REALTIME_PORT=3002
# Open streams per instance, 1-1000000 (default 20000); beyond it new streams get 503.
REALTIME_MAX_CONNECTIONS=20000

# --- worker ---
# (required) Worker Postgres URL (role wb_worker: relay + consumers, cross-tenant via explicit policies).
DATABASE_WORKER_URL=postgres://wb_worker:wb_worker@localhost:5432/wise_biz
# Outbox rows claimed per relay tick, integer 1-5000 (default 500).
WORKER_RELAY_BATCH=500
# Relay sleep when the outbox is empty, ms 10-60000 (default 250).
WORKER_IDLE_MS=250
# Outbox claim lease, ms 1000-3600000 (default 300000). A crashed worker's rows are redelivered after it.
WORKER_LEASE_MS=300000
# Relay publish attempts before a row is quarantined, integer 1-1000 (default 10).
WORKER_MAX_ATTEMPTS=10
# Per-handler timeout in a consumer transaction, ms 100-600000 (default 30000).
WORKER_HANDLER_TIMEOUT_MS=30000
# inventory.batch.expiring fires when a batch with stock expires within this many days, integer 0-365 (default 7).
INVENTORY_EXPIRY_HORIZON_DAYS=7
# devices.heartbeat.missed fires when an active terminal has been silent this many minutes, integer 2-1440 (default 10).
DEVICE_SILENT_MINUTES=10
