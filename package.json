{
  "name": "wise-biz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run check",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps modules packages services",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot apps modules packages services | dot -T svg > docs/deps-graph.svg",
    "changeset": "changeset",
    "prepare": "lefthook install",
    "lint:root": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "24.19.2",
    "@wise-biz/config": "workspace:*",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
