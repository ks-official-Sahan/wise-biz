{
  "name": "@wise-biz/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "wiseBiz": {
    "runtime": "node"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "migrate": "node scripts/migrate.mts",
    "migration": "node scripts/new-migration.mts",
    "rls-check": "node scripts/rls-check.mts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@wise-biz/config": "workspace:*",
    "@wise-biz/testing": "workspace:*",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
