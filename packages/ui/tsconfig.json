{
  "extends": "../config/tsconfig/react.json",
  "compilerOptions": {
    // ESLint's TypeScript resolver follows Tabler's CJS "require" export first and cannot map its .d.cts types, so
    // the import is mapped to the ESM declaration. Type resolution only: runtime resolution is unchanged.
    "paths": {
      "@tabler/icons-react-native": [
        "./node_modules/@tabler/icons-react-native/dist/tabler-icons-react-native.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
