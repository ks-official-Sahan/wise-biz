  },
  "peerDependencies": {
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@wise-biz/config": "workspace:*",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "@types/pg": "8.23.1"
  }
