{
  "name": "@wise-biz/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "wiseBiz": {
    "runtime": "node"
  },
  "exports": {
    ".": "./src/index.ts",
    "./containers": "./src/containers/index.ts"
