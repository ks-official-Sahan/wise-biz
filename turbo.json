{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "//#depcruise": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".dependency-cruiser.cjs",
        "apps/**",
        "modules/**",
        "packages/**",
        "services/**",
        "!**/node_modules/**"
      ],
      "outputs": []
    },
    "check": {
      "dependsOn": ["lint", "typecheck", "test", "//#depcruise", "//#lint:root", "//#env:check"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "//#lint:root": {
      "inputs": ["*.{js,cjs,mjs,ts}", "package.json", "packages/config/**"],
      "outputs": []
    },
    "//#env:check": {
      "inputs": [".env.example", "scripts/check-env-example.mts", "packages/env/src/**"],
      "outputs": []
    }
  }
}
