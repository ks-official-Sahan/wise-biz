    "@wise-biz/events": "workspace:*",
    "@wise-biz/ids": "workspace:*",
    "@wise-biz/mailer": "workspace:*",
    "@wise-biz/module-audit": "workspace:*",
    "@wise-biz/module-tenancy": "workspace:*",
    "pg": "8.23.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@wise-biz/config": "workspace:*",
    "@wise-biz/testing": "workspace:*",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
