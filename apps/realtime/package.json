{
  "name": "@wise-biz/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "wiseBiz": {
    "runtime": "node"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "@opentelemetry/sdk-node": "0.223.0",
    "@wise-biz/env": "workspace:*",
    "@wise-biz/module-sync": "workspace:*",
    "pino": "10.4.0",
    "redis": "6.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@wise-biz/config": "workspace:*",
    "@wise-biz/testing": "workspace:*",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
