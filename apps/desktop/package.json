{
  "name": "@wise-biz/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "wiseBiz": {
    "runtime": "node"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "start": "pnpm build && electron .",
    "e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@wise-biz/hardware": "workspace:*",
    "better-sqlite3": "13.0.3",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.19.2",
    "@wise-biz/config": "workspace:*",
    "@wise-biz/testing": "workspace:*",
    "electron": "45.2.1",
    "eslint": "10.13.0",
    "rolldown": "1.2.14",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
