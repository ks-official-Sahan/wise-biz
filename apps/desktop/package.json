{
  "name": "@wise-biz/desktop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "wiseBiz": {
    "runtime": "node"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "start": "pnpm build && electron .",
    "e2e": "pnpm build && playwright test",
    "package": "node scripts/build.mjs --release && electron-builder --dir",
    "dist": "node scripts/build.mjs --release && electron-builder",
    "package:smoke": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.11",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@wise-biz/config": "workspace:*",
    "@wise-biz/testing": "workspace:*",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "rolldown": "1.2.14",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@wise-biz/hardware": "workspace:*"
  },
  "author": "Wise Biz",
  "description": "Wise Biz POS desktop terminal"
}
